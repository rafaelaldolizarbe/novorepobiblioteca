# MYSQL Configuration
MYSQL_ROOT_PASSWORD=your_root_password
MYSQL_DATABASE=your_database_name
MYSQL_USER=your_username
MYSQL_PASSWORD=your_password
# Spring Boot Configuration
SPRING_DATASOURCE_URL=jdbc:mysql://db_container_name:3306/your_database_name
SPRING_DATASOURCE_USERNAME=your_spring_datasource_username
SPRING_DATASOURCE_PASSWORD=your_spring_datasource_password
ALLOWED_ORIGINS=your_origins
# Host Configuration
LOCAL_VOLUM_DIR=/your/volum/path/volum